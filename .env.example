# WebSpor miljøskabelon
# BEMÆRK: Indsæt ALDRIG hemmelige nøgler eller adgangskoder her.

# Frontend
PUBLIC_API_BASE_URL=https://api.webspor.example
VITE_API_URL=

# API & Admission Control
PORT=8080
SCAN_ENABLED=false
ALLOWED_ORIGINS=https://webspor.example,https://deploy-preview-*.netlify.app
DAILY_SCAN_BUDGET=100
RATE_HMAC_KEY=placeholder-hmac-key-min-32-chars-long
TOKEN_HASH_KEY=placeholder-token-hash-key-min-32-chars

# Scanner Worker & Isolation (ADR-007)
SCANNER_REGION=eu-north-1
EGRESS_POLICY_VERSION=1.0.0

# Valgfri AI-fortolkning (deaktiveret som standard)
AI_ENABLED=false
